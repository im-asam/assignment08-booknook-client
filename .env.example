# BookNook client environment variables.
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it holds secrets.

# Secret used by BetterAuth to sign session cookies AND the JWTs the
# Express server verifies. Must match the server's BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Public URL of this Next.js app (used for auth callbacks).
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas connection string for the `booknook` database.
# Create a cluster at https://cloud.mongodb.com, add a database user,
# allow network access, then paste the connection string here.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/booknook

# Base URL of the Express API server.
NEXT_PUBLIC_API_URL=http://localhost:5000

# imgbb API key for book cover uploads.
# Get one free at https://api.imgbb.com/ (sign in -> API key).
NEXT_PUBLIC_IMGBB_API_KEY=

# Google OAuth (optional — Google sign-in only appears when both are set).
# Create credentials at https://console.cloud.google.com/apis/credentials
# with redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
